# The lab's front door. One password for the whole lab (user: unbranded).
# lab.unbranded.inc gets automatic HTTPS from Caddy once the DNS record exists;
# the :80 block keeps plain-IP access working in the meantime.

lab.unbranded.inc {
	basic_auth {
		{$LAB_USER} {$LAB_HASH}
	}
	reverse_proxy mirofish:3000
}

:80 {
	basic_auth {
		{$LAB_USER} {$LAB_HASH}
	}
	reverse_proxy mirofish:3000
}
