# The lab's front door. One password for the whole lab (user: unbranded).
# Red team fix: credentials only ever travel over HTTPS. The plain-HTTP listener
# redirects BEFORE authentication or proxying, so nothing sensitive crosses it.

lab.unbranded.inc {
	# Flights from The Stack: no password here; every request must carry The Stack's signature,
	# which the app checks before doing anything. Only this one path is open.
	handle /api/unbranded/* {
		reverse_proxy mirofish:5001
	}
	# Everything else is the back room, behind the lab password.
	handle {
		basic_auth {
			{$LAB_USER} {$LAB_HASH}
		}
		reverse_proxy mirofish:3000
	}
}

:80 {
	redir https://lab.unbranded.inc{uri} permanent
}
