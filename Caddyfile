# The lab's front door. One password for the whole lab (user: unbranded).
# Red team fix: credentials only ever travel over HTTPS. The plain-HTTP listener
# redirects BEFORE authentication or proxying, so nothing sensitive crosses it.

lab.unbranded.inc {
	basic_auth {
		{$LAB_USER} {$LAB_HASH}
	}
	reverse_proxy mirofish:3000
}

:80 {
	redir https://lab.unbranded.inc{uri} permanent
}
