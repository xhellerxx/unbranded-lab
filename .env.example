# ===== LLM configuration (any OpenAI-SDK-format API) =====
# unbranded lab default: OpenAI mini-class model for the crowd.
# Consumption is high; keep runs under ~40 rounds.
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5-mini

# ===== Zep memory graph =====
# The free monthly quota covers light use: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM (optional) =====
# A stronger model for the report agent. If unused, REMOVE these lines
# entirely; do not leave them set to placeholders.
LLM_BOOST_API_KEY=your_openai_api_key_here
LLM_BOOST_BASE_URL=https://api.openai.com/v1
LLM_BOOST_MODEL_NAME=gpt-5.1
